# Required for model calls; never commit the real key.
DEEPSEEK_API_KEY=

# ChatGPT/OpenAI-compatible models through CLIProxy API.
CLIPROXY_API_KEY=
CLIPROXY_BASE_URL=https://cli-proxy-api.devtool.uk/v1
CLIPROXY_MODEL=gpt-6.1-sol

# Mastra chat history storage. Use the dedicated database created for this app.
MASTRA_POSTGRES_HOST=pgm-2ze7o54d25m8kn53no.pg.rds.aliyuncs.com
MASTRA_POSTGRES_PORT=5432
MASTRA_POSTGRES_DATABASE=huahuo_mastra_memory_20261025
MASTRA_POSTGRES_USER=huahuo_admin
MASTRA_POSTGRES_PASSWORD=
MASTRA_POSTGRES_SSL=false
# Keep the total across all application instances below the RDS budget.
MASTRA_POSTGRES_POOL_MAX=12
MASTRA_POSTGRES_IDLE_TIMEOUT_MS=30000

# Chat context and thread title behavior.
MASTRA_MEMORY_LAST_MESSAGES=20
MASTRA_MEMORY_GENERATE_TITLE=true

# Current knowledge store: Alibaba Cloud Milvus.
MILVUS_ENDPOINT=
MILVUS_TOKEN=
MILVUS_COLLECTION=huahuo_documents

# Milvus 2.6 dense-vector PoC. Values are intentionally blank.
MILVUS_ADDRESS=
# @zilliz/milvus2-sdk-node expects a gRPC host:port address (no http:// scheme).
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_POC_COLLECTION=huahuo_rag_poc_dense
MILVUS_CONNECT_TIMEOUT_MS=10000
MILVUS_POC_VECTOR_DIM=4
# The supplied test endpoint currently accepts plaintext gRPC on port 19530.
# Set to true only after the deployment's TLS certificate/hostname is verified.
MILVUS_TLS=false

# Retrieval strategy: keyword, semantic, or hybrid.
# Semantic is the current default for the vector store.
RAG_SEARCH_MODE=semantic

# Reserved extension point. Reranking stays disabled until an adapter is provided.
RAG_RERANK_ENABLED=false
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=

# Formal RAG indexing. The selected SiliconFlow model is non-secret; keep the key local only.
# SiliconFlow OpenAI-compatible endpoint. BGE-M3 returns 1024-dimensional vectors.
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
# SiliconFlow documents `dimensions` as Qwen3-only; keep it out of BGE-M3 requests.
RAG_EMBEDDING_SEND_DIMENSIONS=false
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_MAX_INPUT_TOKENS=8192

# Chunk size is an estimated-token budget (heuristic-v1), not a character count.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOKEN_COUNT_STRATEGY=heuristic-v1
RAG_INGEST_BATCH_SIZE=32
RAG_INDEX_PIPELINE_VERSION=v1
RAG_MILVUS_COLLECTION=huahuo_chunks
RAG_STATE_DATABASE_URL=
RAG_STATE_DATABASE_TARGET=pgsql-huahuo-test
# Independent-process PostgreSQL state checks are opt-in and leave only uniquely
# named test rows; they never perform Milvus writes or destructive cleanup.
RAG_STATE_PROCESS_CHECK_ALLOW=false

# Real file ingest uses PostgreSQL by default. Set the process-local flag only
# for local/mock experiments; it is not durable and is not real acceptance evidence.
RAG_INGEST_PROCESS_LOCAL_STATE=false
RAG_INGEST_MARKDOWN_PATH=
RAG_INGEST_SOURCE_ID=
RAG_INGEST_SOURCE_TYPE=article
RAG_INGEST_DOCUMENT_ID=
RAG_INGEST_DOCUMENT_VERSION=
RAG_INGEST_TITLE=
RAG_INGEST_TENANT_ID=
RAG_INGEST_OWNER_ID=
RAG_INGEST_KNOWLEDGE_BASE_ID=

# Dense RAG acceptance is opt-in and restricted to the authorized test target.
RAG_ACCEPTANCE_ALLOW_REAL=false
RAG_ACCEPTANCE_ALLOW_WRITES=false
RAG_ACCEPTANCE_ENVIRONMENT_TARGET=
RAG_MILVUS_INIT_ALLOW=false
