# Default Agent model, and shared Search/Fetch tools.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Active model endpoint: deepseek (default), openai, or cliproxy.
MODEL_PROVIDER=deepseek

# Official OpenAI configuration, available when MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Retained CLIProxy configuration, available when MODEL_PROVIDER=cliproxy.
CLIPROXY_API_KEY=
CLIPROXY_BASE_URL=https://cli-proxy-api.devtool.uk/v1
CLIPROXY_MODEL=gpt-6.1-sol

# Stable private Server origin used by RAG and Studio login; no path suffix.
# Accepts http://<private-ip>:<port> or http://<service-name>:<port>.
# A service name must resolve from Agent; separate Compose networks do not share DNS.
APP_ENV=development
HUAHUO_SERVER_BASE_URL=http://127.0.0.1:13001

# Test Studio: login UI here; authentication and cookie refresh in the Server admission endpoint.
# Disable this for production/API-only deployments.
HUAHUO_STUDIO_AUTH_ENABLED=true
# Keep these equal in Agent, Server and host ingress. Origin contains no path.
HUAHUO_AGENT_PUBLIC_PATH=/agent
HUAHUO_STUDIO_ORIGIN=http://localhost:3000

# Docker reads this same .env file. Use APP_ENV=production for production APIs.
# Set Server URL to an internal address reachable from the Agent container.
# Use the deployment-provided stable private origin, never a temporary release instance.
# 127.0.0.1 above is for a native process; inside Docker it points to Agent itself.
# For separate deployment, use the remote Server address and external=false.
HUAHUO_AGENT_NETWORK=huahuo-agent_default
HUAHUO_AGENT_NETWORK_EXTERNAL=false
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_PORT=4111

# Independent Prometheus listener. Publish on a private/loopback host binding only.
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
# Compose host mapping; keep the unauthenticated listener on loopback.
METRICS_BIND_HOST=127.0.0.1
METRICS_HOST_PORT=9469
# Empty disables all external trace export. Explicit HTTP OTLP /v1/traces endpoint only.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Defaults to package.version and a process UUID. Resource/log fields; info metric only.
OTEL_SERVICE_VERSION=
OTEL_SERVICE_INSTANCE_ID=
LOG_LEVEL=info

# Include Studio in the Docker image. Changing this requires an image rebuild.
MASTRA_BUILD_STUDIO=true
MASTRA_STUDIO_PATH=/app/studio
# Let Studio use the browser's address instead of the container bind address.
MASTRA_AUTO_DETECT_URL=true

# Mastra chat history storage. Use the dedicated database created for this app.
MASTRA_POSTGRES_HOST=pgm-2ze7o54d25m8kn53no.pg.rds.aliyuncs.com
MASTRA_POSTGRES_PORT=5432
MASTRA_POSTGRES_DATABASE=huahuo_mastra_memory_20261025
MASTRA_POSTGRES_USER=huahuo_admin
MASTRA_POSTGRES_PASSWORD=
MASTRA_POSTGRES_SSL=false
# Keep the total across all application instances below the RDS budget.
MASTRA_POSTGRES_POOL_MAX=12
MASTRA_POSTGRES_IDLE_TIMEOUT_MS=30000

# Chat context and thread title behavior.
MASTRA_MEMORY_LAST_MESSAGES=20
MASTRA_MEMORY_GENERATE_TITLE=true
