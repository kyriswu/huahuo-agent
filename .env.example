# Required for model calls; never commit the real key.
DEEPSEEK_API_KEY=

# Current knowledge store: Alibaba Cloud Milvus.
MILVUS_ENDPOINT=
MILVUS_TOKEN=
MILVUS_COLLECTION=huahuo_documents

# Milvus 2.6 dense-vector PoC. Values are intentionally blank.
MILVUS_ADDRESS=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_POC_COLLECTION=huahuo_rag_poc_dense
MILVUS_CONNECT_TIMEOUT_MS=10000
MILVUS_POC_VECTOR_DIM=4
# The supplied test endpoint currently accepts plaintext gRPC on port 19530.
# Set to true only after the deployment's TLS certificate/hostname is verified.
MILVUS_TLS=false

# Retrieval strategy: keyword, semantic, or hybrid.
# Semantic is the current default for the vector store.
RAG_SEARCH_MODE=semantic

# Reserved extension point. Reranking stays disabled until an adapter is provided.
RAG_RERANK_ENABLED=false
RAG_RERANK_BASE_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=

# Formal RAG indexing. Leave embedding values blank until the real model is selected.
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_TIMEOUT_MS=10000
RAG_EMBEDDING_MAX_RETRIES=2

# Chunk size is an estimated-token budget (heuristic-v1), not a character count.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOKEN_COUNT_STRATEGY=heuristic-v1
RAG_INGEST_BATCH_SIZE=32
RAG_INDEX_PIPELINE_VERSION=v1
RAG_MILVUS_COLLECTION=huahuo_chunks
