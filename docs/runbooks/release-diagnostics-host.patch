@@ -23,0 +24,16 @@
+
+# Fixed metadata only; never include command arguments, logs or configuration values.
+diagnostic_check, diagnostic_exit_code = 'unknown', None
+DIAGNOSTIC_CODES = {'baseline': 'BASELINE_CHECK_FAILED', 'disk': 'DISK_SPACE_LOW', 'checkout': 'CHECKOUT_FAILED', 'build': 'BUILD_FAILED', 'configuration': 'CONFIGURATION_INVALID', 'server-admission': 'SERVER_PREFLIGHT_FAILED', 'storage': 'STORAGE_INIT_FAILED', 'candidate': 'CANDIDATE_CHECK_FAILED', 'switch': 'SWITCH_FAILED', 'runtime': 'RUNTIME_CHECK_FAILED', 'cleanup': 'CLEANUP_FAILED', 'unknown': 'UNCLASSIFIED_FAILURE'}
+
+def set_check(value):
+    global diagnostic_check, diagnostic_exit_code
+    diagnostic_check, diagnostic_exit_code = value, None
+
+def failure_diagnostic():
+    check = diagnostic_check if diagnostic_check in DIAGNOSTIC_CODES else 'unknown'
+    value = dict(check=check, code=DIAGNOSTIC_CODES[check])
+    if type(diagnostic_exit_code) is int and 0 <= diagnostic_exit_code <= 255:
+        value['exitCode'] = diagnostic_exit_code
+    return value
+
