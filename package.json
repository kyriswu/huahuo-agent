{
  "name": "huahuo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.11.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "milvus:poc": "node --experimental-strip-types --env-file-if-exists=.env scripts/milvus-poc.ts",
    "rag:test": "vitest run",
    "rag:ingest:mock": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-ingest-mock.ts",
    "rag:milvus:init": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-milvus-init.ts"
  },
  "dependencies": {
    "@mastra/core": "1.78.0",
    "@zilliz/milvus2-sdk-node": "2.6.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "mastra": "1.34.2",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  }
}
