{
  "name": "huahuo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=26.11.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rag:test": "vitest run",
    "rag:ingest:mock": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-ingest-mock.ts",
    "rag:embedding:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-embedding-check.ts",
    "rag:state:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-state-migrate.ts",
    "rag:state:process-check": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-state-process-check.ts",
    "rag:recovery:run": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-recovery-run.ts",
    "rag:reconcile": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-reconcile.ts",
    "rag:acceptance:dense:mock": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-acceptance-dense.ts",
    "release:check": "node scripts/release/release-plan.mjs",
    "release:smoke": "node scripts/release/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.85",
    "@mastra/core": "1.83.0",
    "@mastra/editor": "0.17.1",
    "@mastra/memory": "1.41.1",
    "@mastra/pg": "1.36.0",
    "jose": "6.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@alicloud/openapi-core": "1.0.9",
    "@darabonba/typescript": "1.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "mastra": "1.39.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "volta": {
    "node": "26.11.0",
    "npm": "11.20.0"
  }
}
