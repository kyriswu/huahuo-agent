{
  "name": "huahuo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=26.11.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rag:test": "vitest run",
    "rag:ingest:mock": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-ingest-mock.ts",
    "rag:embedding:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-embedding-check.ts",
    "rag:state:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-state-migrate.ts",
    "rag:state:process-check": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-state-process-check.ts",
    "rag:recovery:run": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-recovery-run.ts",
    "rag:reconcile": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-reconcile.ts",
    "rag:acceptance:dense:mock": "node --experimental-strip-types --env-file-if-exists=.env scripts/rag-acceptance-dense.ts",
    "release:smoke": "node scripts/release/smoke.mjs",
    "test:studio:built": "node scripts/studio-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.85",
    "@mastra/core": "1.85.0",
    "@mastra/editor": "0.17.2",
    "@mastra/memory": "1.41.2",
    "@mastra/observability": "1.24.2",
    "@mastra/otel-bridge": "1.6.1",
    "@mastra/pg": "1.37.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.1",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-node": "0.223.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@prometheus-io/client": "0.16.1",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mastra/server": "1.85.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "mastra": "1.40.1",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "volta": {
    "node": "26.11.0",
    "npm": "11.20.0"
  }
}
